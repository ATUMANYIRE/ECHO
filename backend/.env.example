# ECHO Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8005
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:3005","http://127.0.0.1:3005","http://localhost:3000"]

# LLM Provider Configuration (Required in Milestone 4)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Execution Sandbox Configuration (Milestone 2)
EXECUTION_TIMEOUT_SECONDS=5.0
SANDBOX_STARTUP_TIMEOUT_SECONDS=20.0
EXECUTION_MAX_MEMORY_MB=128
EXECUTION_MAX_STEPS=500
